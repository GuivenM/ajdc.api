+        foreach ($mediaIds as $i => $mediaId) {
+            $payload["attached_media[{$i}]"] = json_encode(['media_fbid' => $mediaId]);
+        }
+
+        $response = Http::asForm()->post("https://graph.facebook.com/v21.0/{$pageId}/feed", $payload);
+
         if ($response->failed()) {
